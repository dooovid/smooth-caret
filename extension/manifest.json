{
  "manifest_version": 3,
  "name": "Smooth Caret",
  "version": "1.0.0",
  "description": "A smooth, gliding text caret on every site, in inputs, textareas and rich editors. Set its speed, easing, width and color.",
  "homepage_url": "https://github.com/dooovid/smooth-caret",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
